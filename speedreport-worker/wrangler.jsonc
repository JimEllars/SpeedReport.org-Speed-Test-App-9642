{
  // Release workflow: run `npm run deploy:dry-run`, open a PR, then let the
  // maintainer merge it. Configure secrets with `wrangler secret put`; never
  // add secrets or patch artifacts to this file.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "speedreport-edge-engine",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "routes": [
    {
      "pattern": "speedreport.org",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Paths the Worker must see before the asset router does. Without an entry
    // here the request is served (or SPA-fell-back) by the asset layer and
    // `isBlockedRequest()` never runs - which is exactly what happened in
    // production: `/api/*` returned 403 for hostile payloads while
    // `/wp-admin/`, `/xmlrpc.php` and `/cgi-bin/*` returned a 200 index.html.
    //
    // The hostile shapes below are paths no legitimate visitor or crawler
    // requests, so routing them here costs nothing in practice and lets the
    // 403 screen fire. Wildcards match any character sequence, so `/*.php`
    // covers a PHP probe at any depth.
    //
    // Residual: a query-string-only vector such as `/?-d+allow_url_include=on`
    // cannot be matched here because these patterns constrain the path, not the
    // query. Closing that requires `run_worker_first: true`, which makes every
    // static asset request a billable Worker invocation. Not needed today: the
    // asset origin is Cloudflare's static store, not a PHP interpreter, so there
    // is no CGI for the argument to reach. Documented in
    // Continued Development Plan.md for the operator to decide.
    "run_worker_first": [
      "/api/*",
      "/health",
      "/wp-admin/*",
      "/wp-login.php",
      "/wp-content/*",
      "/wp-includes/*",
      "/xmlrpc.php",
      "/cgi-bin/*",
      "/*.php",
    ],
  },
  "analytics_engine_datasets": [
    {
      "binding": "TELEMETRY",
      "dataset": "speedreport_telemetry",
    },
  ],
  // PROSPECT_STORE backs the satellite dead-letter queue (`dlq:lead:{testId}`,
  // 86400s TTL) and the per-IP lead rate limiter. The binding is deliberately
  // omitted until the namespace exists — publishing a placeholder id makes
  // `wrangler deploy` fail. Create it once, then uncomment and paste the id:
  //
  //   cd speedreport-worker
  //   npx wrangler kv namespace create PROSPECT_STORE --config wrangler.jsonc
  //
  // "kv_namespaces": [
  //   { "binding": "PROSPECT_STORE", "id": "<namespace-id-from-above>" },
  // ],
  "triggers": {
    "crons": ["0 12 * * *"],
  },
  "vars": {
    "REPORT_RECIPIENT_TO": "contact@speedreport.org",
    "REPORT_RECIPIENT_BCC": "jrellars@gmail.com",
  },
}
