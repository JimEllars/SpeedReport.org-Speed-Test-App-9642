{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "speedreport-edge-engine",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "routes": [
    {
      "pattern": "speedreport.org",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"],
  },
  "analytics_engine_datasets": [
    {
      "binding": "TELEMETRY",
      "dataset": "speedreport_telemetry",
    },
  ],
  "triggers": {
    "crons": ["0 12 * * *"],
  },
  "vars": {
    "RESEND_API_KEY": "",
    "REPORT_RECIPIENT_TO": "james.ellars@axim.us.com",
    "REPORT_RECIPIENT_BCC": "jrellars@gmail.com",
  },
}
