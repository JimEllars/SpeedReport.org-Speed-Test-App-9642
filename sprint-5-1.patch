+
+        try {
+          localStorage.setItem(key, JSON.stringify(pruned));
+          return pruned;
+        } catch (e) {
+          if (e.name === 'QuotaExceededError' || e.code === 22) {
+            currentData = pruned;
+            continue; // Keep pruning
+          }
+          return current;
+        }
+      }
+    }
+    return current;
+  }
+};
